{
  "name": "dsh-myskin",
  "description": "DSH Web 皮肤插件：可视化自定义 + 实时预览 + 「皮肤管理」设置页。非侵入式、可逆覆盖层；适配 DSH 0.1.7-rc.2（Web 与 Desktop 共用同一条客户端插件管线）。",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./lib/index.js" },
    "./client": { "types": "./src/client/index.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "src", "skills", "README.md"],
  "scripts": {
    "build": "node scripts/build.cjs",
    "bundle": "node scripts/build.cjs",
    "watch": "node scripts/build.cjs --watch",
    "test": "node --test tests/*.test.mjs",
    "check:compat": "node scripts/check-compat.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "^0.1.7-rc.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "react": "^18.2.0"
  }
}
