{
  "name": "dsh-myskin",
  "description": "DSH 通用皮肤框架：可视化自定义 + 实时预览 + 「皮肤管理」，可以随心设计你的专属皮肤，并通过分发皮肤包和你的小伙伴们分享。非侵入式、可逆覆盖层，适配 DSH 0.1.7-rc.2 / 0.2.0-rc.1 / 0.2.0-rc.2（Web 与 Desktop 共用同一条客户端插件管线）。",
  "version": "0.4.0",
  "license": "MIT",
  "author": "WTStarMark <2182219890@qq.com>",
  "repository": { "type": "git", "url": "git+https://github.com/WTStarMark/dsh-myskin.git" },
  "homepage": "https://github.com/WTStarMark/dsh-myskin#readme",
  "bugs": { "url": "https://github.com/WTStarMark/dsh-myskin/issues" },
  "keywords": ["dsh", "deepseek-harness", "plugin", "skin", "theme", "desktop"],
  "type": "module",
  "main": "lib/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./lib/index.js" },
    "./client": { "types": "./src/client/index.ts", "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "src", "skills", "docs", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.cjs",
    "bundle": "node scripts/build.cjs",
    "watch": "node scripts/build.cjs --watch",
    "test": "node --test tests/*.test.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "check:types": "node scripts/check-types.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": ">=0.1.7-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "esbuild": "^0.25.0",
    "jsdom": "^25.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.9.0"
  }
}
