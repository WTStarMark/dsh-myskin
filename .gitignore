# ── 依赖与构建中间产物 ─────────────────────────────────────────────
# lib/（构建产物）是交付物，必须提交；下面这些不是。
node_modules/
.tmp/
# 锁文件不入库：插件本体自带依赖，开发时各自 npm install 生成即可。
package-lock.json
*.tsbuildinfo
*.tgz

# ── 打包 / 发布产物（本地生成，不进仓库）────────────────────────────
*.zip
# 打包脚本先写 .part、再原子改名，崩溃时留下的半成品同样不入库
*.part
*.tar.gz
*.dshskin
dsh-myskin-*/
dsh-myskin-repo-*/

# ── 日志与临时文件 ─────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
*.pid
*.tmp
*.bak
*.orig
*.rej

# ── 编辑器 / 操作系统 ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── 本地环境与凭据（绝不入库）──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
.credentials*
